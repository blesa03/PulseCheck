DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=status.example.com,backend
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_MAX_REQUEST_BYTES=65536

POSTGRES_DB=pulsecheck
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=https://status.example.com
CSRF_TRUSTED_ORIGINS=https://status.example.com
VITE_API_URL=/api
JWT_SIGNING_KEY=replace-with-an-independent-long-random-signing-key
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Lax

TRUSTED_PROXY_COUNT=1
RATE_ANON=120/min
RATE_USER=600/min
RATE_AUTH=30/min
RATE_MANUAL_CHECK=12/min
RATE_PUBLIC_STATUS=120/min
MONITOR_DISPATCH_BATCH_SIZE=200
CHECK_RETENTION_DELETE_BATCH_SIZE=5000
PULSECHECK_HTTP_PORT=8080